FORM set_param_table CHANGING itab_ref.

  DATA:
    tdescr_p      TYPE REF TO cl_abap_typedescr,
    table_descr_p TYPE REF TO cl_abap_tabledescr.

  FIELD-SYMBOLS: <itab> TYPE ANY TABLE.

  tdescr_p = cl_abap_typedescr=>describe_by_data_ref( itab_ref ).


  ASSIGN itab_ref->* TO <itab>.
  CREATE DATA gv_itab_line_ref LIKE LINE OF <itab>.

  PERFORM set_param_struct CHANGING gv_itab_line_ref.
  gv_itab_ref = itab_ref.

ENDFORM.
FORM set_param_struct CHANGING struct_ref.

  DATA:
    tdescr_p TYPE REF TO cl_abap_typedescr,
    sdescr_p TYPE REF TO cl_abap_structdescr.

  tdescr_p = cl_abap_typedescr=>describe_by_data_ref( struct_ref ).
  sdescr_p ?= tdescr_p.

  LOOP AT sdescr_p->components ASSIGNING FIELD-SYMBOL(<comp>).

    PERFORM add_comp_ref CHANGING struct_ref
                                  <comp>.
  ENDLOOP.

ENDFORM.
FORM add_comp_ref CHANGING struct_ref TYPE REF TO data
                           comp_descr TYPE abap_compdescr.


  FIELD-SYMBOLS:
    <param> LIKE LINE OF lt_param_tab,
    <f>     TYPE any.

*   derefernce given DATA_REF
  FIELD-SYMBOLS <struct> TYPE any.
  ASSIGN struct_ref->* TO <struct>.

* get a reference to the specified component of the structure and append
* it to PARAM_TAB
  ASSIGN COMPONENT comp_descr-name OF STRUCTURE <struct> TO <f>.
  APPEND INITIAL LINE TO lt_param_tab ASSIGNING <param>.
  GET REFERENCE OF <f> INTO <param>-data_ref.


ENDFORM.